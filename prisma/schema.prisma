generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Whale {
  id       Int     @id @default(autoincrement())
  address  String  @unique
  name     String?
  isActive Boolean @default(true)
  trades   Trade[]
}

model Account {
  id             Int   @id @default(0)
  virtualBalance Float @default(100.0)
}

model Trade {
  id          Int      @id @default(autoincrement())
  tokenMint   String
  tokenSymbol String?
  side        String   // 'BUY' | 'SELL'
  priceUsd    Float
  amountUsd   Float
  isBot       Boolean  // true = virtual trade, false = whale move
  timestamp   DateTime @default(now())
  whaleId     Int?
  whale       Whale?   @relation(fields: [whaleId], references: [id])
}